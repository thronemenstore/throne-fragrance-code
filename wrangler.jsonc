{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throne-fragrance",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "throne-fragrance-db", "database_id": "850fbc15-4c34-487b-b99c-7a9f10158d02", "migrations_dir": "migrations" }]
}
